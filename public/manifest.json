{
  "manifest_version": 3,
  "name": "Trying to make a Web3 Wallet",
  "version": "1.0.0",
  "description": "A non-custodial Web3 wallet for the Sepolia Testnet.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Open Wallet"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.publicnode.com/*",
    "https://*.sepolia.org/*"
  ]
}